{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/check-source.sh\"",
            "statusMessage": "Checking source style"
          }
        ]
      }
    ]
  }
}
