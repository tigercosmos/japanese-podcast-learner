{
  "permissions": {
    "allow": [
      "Shell(make)",
      "Shell(make:help*)",
      "Shell(make:install*)",
      "Shell(make:pyinstall*)",
      "Shell(make:npminstall*)",
      "Shell(make:serve*)",
      "Shell(make:dev*)",
      "Shell(make:test*)",
      "Shell(make:pytest*)",
      "Shell(make:vitest*)",
      "Shell(make:e2e*)",
      "Shell(make:lint*)",
      "Shell(make:flake8*)",
      "Shell(make:checktws*)",
      "Shell(make:eslint*)",
      "Shell(make:tsc*)",
      "Shell(make:build*)",
      "Shell(pytest)",
      "Shell(python:-m pytest*)",
      "Shell(python3:-m pytest*)",
      "Shell(python3:-m flake8*)",
      "Shell(flake8)",
      "Shell(npm:run lint*)",
      "Shell(npm:run test*)",
      "Shell(npm:run build*)",
      "Shell(npx:tsc*)",
      "Shell(npx:vitest*)",
      "Shell(npx:playwright test*)",
      "Shell(ls)",
      "Shell(wc)",
      "Shell(find)",
      "Shell(grep)",
      "Shell(rg)",
      "Shell(tree)",
      "Shell(jq)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:branch*)",
      "Shell(git:remote*)",
      "Shell(git:ls-files*)",
      "Shell(git:rev-parse*)",
      "Shell(gh:pr view*)",
      "Shell(gh:pr list*)",
      "Shell(gh:pr diff*)",
      "Shell(gh:pr checks*)",
      "Shell(gh:issue view*)",
      "Shell(gh:issue list*)",
      "Read(**/*)",
      "Write(**/*)",
      "Glob(**/*)",
      "Grep(**/*)",
      "Task(**/*)",
      "WebSearch(**/*)",
      "WebFetch(**/*)"
    ],
    "deny": [
      "Shell(rm:-rf*)",
      "Shell(sudo:*)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Write(.env*)",
      "Write(**/.env*)"
    ]
  }
}
